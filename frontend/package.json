    "vitest": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^22.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "@vue/test-utils": "^2.5.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0"
