{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.markcheli.com/schemas/privacy.schema.json",
  "title": "Privacy policy (content/privacy.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated",
    "intro",
    "sections",
    "contact"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "paragraphs"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "contact": {
      "type": "string",
      "minLength": 1
    }
  }
}
