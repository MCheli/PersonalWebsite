{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.markcheli.com/schemas/projects.schema.json",
  "title": "Portfolio projects (content/projects.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "projects"],
  "properties": {
    "$comment": { "type": "string" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "tagline", "description", "highlights", "stack", "repo", "status", "started", "featured"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": { "type": "string", "minLength": 1 },
          "highlights": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "stack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "repo": { "type": "string", "pattern": "^https://github\\.com/MCheli/[A-Za-z0-9_.-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "demo": { "type": "string", "pattern": "^https://" },
          "status": { "type": "string", "enum": ["active", "pre-release", "done", "archived"] },
          "started": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
          "featured": { "type": "boolean" }
        }
      }
    }
  }
}
